{
  "name": "provenance-landing",
  "private": true,
  "version": "1.0.0",
  "description": "provtools.com: the Provenance landing page",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "shots": "node scripts/shots.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "stills": "node scripts/stills.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "gsap": "^3.15.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/three": "^0.186.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  }
}
